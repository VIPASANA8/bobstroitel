POKER8_ENV=development
POKER8_DATABASE_URL=postgresql+psycopg://poker8:poker8@127.0.0.1:5432/poker8
POKER8_DEFAULT_TENANT=poker8
POKER8_DEFAULT_BOT_TOKEN=
POKER8_OPEN_ACCESS=0
# off | mock (development/test only) | production (POKER8_ENV=production only)
POKER8_CASH_MODE=off
# Required by production mode, and unused by the others. An HTTPS hostname with
# a trusted certificate: the pinned partner source ships TLS verification off
# against a self-signed certificate on a bare IP, and that is not carried over.
POKER8_CASH_FIAT_API_URL=
POKER8_CASH_FIAT_TOKEN=
# Who signs and holds the keys for an outgoing payout -- never this application.
# No provider is implemented yet, so naming one refuses the boot on purpose.
POKER8_CASH_PAYOUT_PROVIDER=
POKER8_CASH_ALLOWLIST=
# Payout cost charged to the person asking for it; 0 means the house pays.
# The pilot charges 5 for a C2C withdrawal.
POKER8_CASH_WITHDRAWAL_FEE_USDT=0
POKER8_LEGACY_PLAY_ROOMS=0
POKER8_DEV_PROFILES=101:Dev Player,202:Second Player
