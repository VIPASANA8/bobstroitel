POKER8_ENV=development
POKER8_DATABASE_URL=postgresql+psycopg://poker8:poker8@127.0.0.1:5432/poker8
POKER8_DEFAULT_TENANT=poker8
POKER8_DEFAULT_BOT_TOKEN=
POKER8_OPEN_ACCESS=0
POKER8_CASH_MODE=off
POKER8_CASH_ALLOWLIST=
# Payout cost charged to the person asking for it; 0 means the house pays.
# The pilot charges 5 for a C2C withdrawal.
POKER8_CASH_WITHDRAWAL_FEE_USDT=0
POKER8_LEGACY_PLAY_ROOMS=0
POKER8_DEV_PROFILES=101:Dev Player,202:Second Player
