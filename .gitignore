.venv/
__pycache__/
.pytest_cache/
*.pyc
.env
.env.*
!.env.example
data/poker8_online_dev.sqlite3
data/*.sqlite3
# SQLite writes these alongside the database and they are not covered above
data/*.sqlite3-wal
data/*.sqlite3-shm
data/*.sqlite3-journal

# Секреты и локальные доступы — не коммитить
# servers.md -- имя из PROJECT_INDEX.md; на диске файл называется
# server.md, так что это правило закрывало то, чего нет, а рутовый
# пароль лежал открытым. Оба имени, чтобы промах не повторился.
servers.md
server.md
prod.md
# Партнёрские выгрузки: токены, service-key и пароли БД приходят в них открытым
# текстом. То же продублировано в .git/info/exclude, чтобы правило действовало
# во всех worktree независимо от ветки.
case*.md
case*.txt
*p2pconfig*

# Локальные наработки инструментов
.superpowers/
.worktrees/
