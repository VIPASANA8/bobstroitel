# Poker8 — Caddy reverse-proxy с автоматическим TLS (Let's Encrypt).
# Оба домена обслуживаются одним сайтом: donbas.win — вариант написания
# без второй "s", отдельный редирект не нужен. Caddy проксирует WebSocket
# (/ws/) прозрачно, отдельная секция не нужна.

donbass.win, www.donbass.win, donbas.win, www.donbas.win {
    encode zstd gzip

    reverse_proxy app:8000 {
        # долгоживущие WebSocket-соединения стола
        transport http {
            read_timeout 3600s
        }
    }
}
